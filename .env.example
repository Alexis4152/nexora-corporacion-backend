# Variables de entorno del backend. Copia a .env (ignorado por git) en local o defínelas en el orquestador.
# NUNCA subas valores reales. Genera secretos con:  openssl rand -base64 48
# Perfil: dev por defecto. En producción: SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://localhost:5432/nexora_corporacion
DB_USERNAME=postgres
DB_PASSWORD=

# Obligatorias (mínimo 32 caracteres, distintas entre sí)
APP_JWT_SECRET=
APP_ENCRYPTION_KEY=

# Cookie del refresh token. Producción con HTTPS: true. Strict si frontend y API comparten sitio.
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Strict

APP_FRONTEND_URL=http://localhost:5181
APP_CORS_ALLOWED_ORIGINS=http://localhost:5181
# Producción: ruta ABSOLUTA de un volumen persistente
APP_STORAGE_DIR=./data/storage

# Alta inicial del SUPER_ADMIN (solo si no existe ninguno). Bórralas después del primer arranque.
APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# SOLO perfil dev: datos de demostración (14 meses de historia) y usuarios por rol. Prohibido en prod.
APP_DEMO_DATA=false
APP_DEMO_PASSWORD=

# Opcionales
# SERVER_PORT=8091
# APP_JWT_ACCESS_TTL=PT15M
# APP_JWT_REFRESH_TTL=PT10H
# APP_REAUTH_WINDOW=PT10M
